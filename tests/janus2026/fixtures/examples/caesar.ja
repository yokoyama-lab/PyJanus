// Reversible Caesar cipher migrated from examples/.
// Demonstrates: char arrays, call/uncall reversibility.

void caesar(char buf[12], int key) {
    for (int i = 0; i < 11; i += 1) {
        local int ch = buf[i] {
            if (ch >= 97 && ch <= 122) {
                buf[i] -= ch;
                buf[i] += (ch - 97 + key) % 26 + 97;
            } fi (buf[i] >= 97 && buf[i] <= 122);
        } delocal int ch = (buf[i] >= 97 && buf[i] <= 122 ? (buf[i] - 97 - key + 26) % 26 + 97 : buf[i]);
    }
}

void main() {
    char msg[12] = "hello world";
    int key = 3;
    printf("plain:  %s\n", msg);
    call caesar(msg, key);
    printf("cipher: %s\n", msg);
    uncall caesar(msg, key);
    printf("back:   %s\n", msg);
}
