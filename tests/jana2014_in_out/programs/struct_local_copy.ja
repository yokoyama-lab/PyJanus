// `local struct Ref e = out[j]` copies all fields of out[j] into a new local
// struct e, equivalent to the three-line idiom:
//     local int dist = out[j].dist
//     local int len  = out[j].len
//     local int next = out[j].next
// e is read-only inside the body, so delocal asserts e == out[j] and frees.
// Iterates two elements and writes the running field sum.
// in:
// out: 33
struct Ref {
    int dist,
    int len,
    int next
}

procedure main()
  Ref out[2]
  int s
  out[0].dist += 3
  out[0].len  += 2
  out[0].next += 9
  out[1].dist += 7
  out[1].len  += 5
  out[1].next += 7
  iterate int j = 0 to 1
    local struct Ref e = out[j]
      s += e.dist + e.len + e.next
    delocal struct Ref e = out[j]
  end
  write s
  out[0].next -= 9
  out[0].len  -= 2
  out[0].dist -= 3
  out[1].next -= 7
  out[1].len  -= 5
  out[1].dist -= 7
