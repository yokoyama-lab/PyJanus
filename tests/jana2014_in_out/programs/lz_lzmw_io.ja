// LZ-family LZMW (Miller-Wegman): reversible jana2014_in_out program.
// Reads 8 symbols (in[0]=length prefix), runs rev_lzmw_struct, writes out[0..9].
// Backward run uncalls it (decodes) and reproduces the input.
// Self-contained copy from RevLZ pcp/in_out; proof: coq/LZMW.v decode_encode (axiom-free).
// Symbols are 1..alphSize-1 (alphSize=10); dictSize=20.
// case: abcabc
// in: 1 2 3 1 2 3 1 2
// out: 5 1 2 3 10 12 0 0 0 0
// case: alt12
// in: 1 2 1 2 1 2 2 2
// out: 6 1 2 10 10 2 2 0 0 0
// case: distinct
// in: 1 2 3 4 5 6 7 8
// out: 8 1 2 3 4 5 6 7 8 0
// case: ones
// in: 1 1 1 1 1 1 1 1
// out: 5 1 1 10 11 1 0 0 0 0
// case: runs
// in: 3 3 1 1 2 2 3 3
// out: 7 3 3 1 1 2 2 10 0 0

/* PyJanus-compatible copy of lz78/lzmw_struct_base.ja.
   Identical logic; only the struct field separators are changed from the
   Jana-JanusInterp comma form to the jana2014 semicolon form so PyJanus's
   parser accepts it.  The algorithm is the one proved clean reversible in
   coq/LZMW.v (decode_encode, axiom-free). */

struct DictEntry {
    int left;
    int right;
    int depth;
    int first;
}


procedure init_dict_lzmw(DictEntry d[], int n, int S[][], int alphSize)
  from n = 0 loop
    n += 1
    d[n].depth += 1
    d[n].first += n
    S[n][0] += n
  until n = alphSize - 1
  n += 1


procedure copy_string_at(int S[][], int dst, int src, int offset, int len, int maxLen)
  local int p = 0
  from p = 0 loop
    if p < len then
      S[dst][offset + p] += S[src][p]
    fi p < len
    p += 1
  until p = maxLen
  delocal int p = maxLen


procedure add_to_dict_lzmw(int lc, int rc, DictEntry d[], int n, int S[][], int maxLen)
  d[n].left ^= lc
  d[n].right ^= rc
  local int dl = d[lc].depth
  local int dr = d[rc].depth
  d[n].depth += dl + dr
  d[n].first ^= d[lc].first
  local int zero = 0
  call copy_string_at(S, n, lc, zero, dl, maxLen)
  delocal int zero = 0
  call copy_string_at(S, n, rc, dl, dr, maxLen)
  delocal int dr = d[rc].depth
  delocal int dl = d[lc].depth
  n += 1


procedure count_mismatches(int S[][], int e, int in[], int pos, int depth, int maxLen, int mis)
  local int k = 0
  from k = 0 loop
    if k < depth then
      if S[e][k] != in[pos + k] then
        mis += 1
      fi S[e][k] != in[pos + k]
    fi k < depth
    k += 1
  until k = maxLen
  delocal int k = maxLen


procedure uncount_mismatches(int S[][], int e, int in[], int pos, int depth, int maxLen, int mis)
  local int k = 0
  from k = 0 loop
    if k < depth then
      if S[e][k] != in[pos + k] then
        mis -= 1
      fi S[e][k] != in[pos + k]
    fi k < depth
    k += 1
  until k = maxLen
  delocal int k = maxLen


procedure mark_matches(int S[][], int in[], int pos, DictEntry d[],
                       int n, int maxLen, int alphSize, int dictSize,
                       int md[], int remaining)
  md[1] += 1
  local int e = alphSize
  from e = alphSize loop
    if e < n && d[e].depth <= remaining then
      local int mis = 0
      call count_mismatches(S, e, in, pos, d[e].depth, maxLen, mis)
      if mis = 0 then
        md[d[e].depth] += 1
      fi mis = 0 && md[d[e].depth] > 0
      call uncount_mismatches(S, e, in, pos, d[e].depth, maxLen, mis)
      delocal int mis = 0
    fi e < n && d[e].depth <= remaining
    e += 1
  until e = dictSize
  delocal int e = dictSize


procedure unmark_matches(int S[][], int in[], int pos, DictEntry d[],
                         int n, int maxLen, int alphSize, int dictSize,
                         int md[], int remaining)
  local int e = dictSize
  from e = dictSize loop
    e -= 1
    if e >= alphSize && e < n && d[e].depth <= remaining then
      local int mis = 0
      call count_mismatches(S, e, in, pos, d[e].depth, maxLen, mis)
      if mis = 0 then
        md[d[e].depth] -= 1
      fi mis = 0 && md[d[e].depth] >= 0
      call uncount_mismatches(S, e, in, pos, d[e].depth, maxLen, mis)
      delocal int mis = 0
    fi e >= alphSize && e < n && d[e].depth <= remaining
  until e = alphSize
  delocal int e = alphSize
  md[1] -= 1


procedure find_max_depth(int md[], int max_d, int maxLen)
  local int d = maxLen
  from d = maxLen loop
    if md[d] > 0 && max_d = 0 then
      max_d += d
    fi md[d] > 0 && max_d = d
    d -= 1
  until d = 0
  delocal int d = 0


procedure unfind_max_depth(int md[], int max_d, int maxLen)
  local int d = 1
  from d = 1 loop
    if md[d] > 0 && max_d = d then
      max_d -= d
    fi md[d] > 0 && max_d = 0
    d += 1
  until d = maxLen + 1
  delocal int d = maxLen + 1


procedure find_code_at_depth(int S[][], int in[], int pos, DictEntry d[],
                             int n, int maxLen, int dictSize, int max_d, int code)
  if max_d = 1 then
    code += in[pos]
  fi max_d = 1 && code = in[pos]
  if max_d > 1 then
    local int e = 0
    from e = 0 loop
      if e < n && d[e].depth = max_d && code = 0 then
        local int mis = 0
        call count_mismatches(S, e, in, pos, max_d, maxLen, mis)
        if mis = 0 then
          code += e
        fi mis = 0 && code = e
        call uncount_mismatches(S, e, in, pos, max_d, maxLen, mis)
        delocal int mis = 0
      fi e < n && d[e].depth = max_d && (code = 0 || code = e)
      e += 1
    until e = dictSize
    delocal int e = dictSize
  fi max_d > 1


procedure unfind_code_at_depth(int S[][], int in[], int pos, DictEntry d[],
                               int n, int maxLen, int dictSize, int max_d, int code)
  if max_d > 1 then
    local int e = dictSize
    from e = dictSize loop
      e -= 1
      if e < n && d[e].depth = max_d && code = e then
        local int mis = 0
        call count_mismatches(S, e, in, pos, max_d, maxLen, mis)
        if mis = 0 then
          code -= e
        fi mis = 0 && code = 0
        call uncount_mismatches(S, e, in, pos, max_d, maxLen, mis)
        delocal int mis = 0
      fi e < n && d[e].depth = max_d && (code = e || code = 0)
    until e = 0
    delocal int e = 0
  fi max_d > 1
  if max_d = 1 && code = in[pos] then
    code -= in[pos]
  fi max_d = 1 && code = 0


procedure zero_matched_input(int in[], int i, int S[][], int code, int match_len, int maxLen)
  local int k = 0
  from k = 0 loop
    if k < match_len then
      in[i + k] -= S[code][k]
    fi k < match_len
    k += 1
  until k = maxLen
  delocal int k = maxLen


procedure compress_lzmw(int in[], int out[], int i, int j, DictEntry d[], int n,
                        int S[][], int dictSize, int alphSize, int maxLen)
  call init_dict_lzmw(d, n, S, alphSize)
  i += 1
  if in[i] != 0 then
    from j = 0 loop
      local int remaining = in[0] - i + 1

      // Phase 1: Mark matching depths.
      local int md[maxLen + 1]
      call mark_matches(S, in, i, d, n, maxLen, alphSize, dictSize, md, remaining)

      // Phase 2: Find max matching depth.
      local int max_d = 0
      call find_max_depth(md, max_d, maxLen)

      // Phase 3: Find entry code at max depth.
      local int code = 0
      call find_code_at_depth(S, in, i, d, n, maxLen, dictSize, max_d, code)

      // Store code in output.
      j += 1
      out[j] <=> code
      delocal int code = 0

      // Cleanup: reverse phases 3, 2, 1.
      call unfind_max_depth(md, max_d, maxLen)
      delocal int max_d = 0
      call unmark_matches(S, in, i, d, n, maxLen, alphSize, dictSize, md, remaining)
      delocal int md[maxLen + 1]
      delocal int remaining = in[0] - i + 1

      // Zero matched input.
      local int ml = d[out[j]].depth
      call zero_matched_input(in, i, S, out[j], ml, maxLen)
      delocal int ml = d[out[j]].depth

      // Advance position.
      i += d[out[j]].depth

      // Add LZMW entry for consecutive pair.
      if j > 1 then
        if n < dictSize then
          call add_to_dict_lzmw(out[j - 1], out[j], d, n, S, maxLen)
        else
          n += 1
        fi n <= dictSize
      fi j > 1
    until in[i] = 0
  fi j > 0
  in[0] -= i - 1
  out[0] += j


procedure build_dict_lzmw(int out[], int i, int j, DictEntry d[], int n,
                          int S[][], int dictSize, int alphSize, int maxLen)
  call init_dict_lzmw(d, n, S, alphSize)
  i += 1
  from j = 0 loop
    j += 1
    i += d[out[j]].depth
    if j < out[0] then
      if n < dictSize then
        call add_to_dict_lzmw(out[j], out[j + 1], d, n, S, maxLen)
      else
        n += 1
      fi n <= dictSize
    fi j < out[0]
  until j = out[0]


procedure rev_lzmw_struct(int in[], int out[], int dictSize, int alphSize, int maxLen)
  local int i = 0, int j = 0, int n = 0, int S[dictSize][maxLen], DictEntry d[dictSize]
  call compress_lzmw(in, out, i, j, d, n, S, dictSize, alphSize, maxLen)
  uncall build_dict_lzmw(out, i, j, d, n, S, dictSize, alphSize, maxLen)
  delocal int i = 0, int j = 0, int n = 0, int S[dictSize][maxLen], DictEntry d[dictSize]

procedure main()
    int in[10]
    int out[10]
    read in[1]
    read in[2]
    read in[3]
    read in[4]
    read in[5]
    read in[6]
    read in[7]
    read in[8]
    in[0] += 8
    call rev_lzmw_struct(in, out, 20, 10, 10)
    write out[0]
    write out[1]
    write out[2]
    write out[3]
    write out[4]
    write out[5]
    write out[6]
    write out[7]
    write out[8]
    write out[9]
