// Second-order reversible cellular automaton (Rule 90R).
//
// A clean reversible simulation of an injective map. The update is
//     new[i] = (cur[i-1] XOR cur[i+1]) XOR prev[i]
// which, written in place as `prev[i] ^= cur[i-1] ^ cur[i+1]`, turns the
// older generation into the next one. XOR is its own inverse, so the whole
// evolution runs backward by replaying the same updates in reverse order:
// no ancillae, no history, no garbage -- reversibility by construction.
//
// Two arrays a (prev) and b (cur), real cells at indices 1..3; the guard
// cells 0 and 4 stay 0 (zero boundary). One `step` advances dst using src;
// two steps advance time by 2 and restore the array roles. Because `^` works
// bitwise on whole integers, this is a bijection on Z^3 x Z^3, not just bits.
//
// Forward maps (cur, prev) -> (cur'', prev'); writing both generations clears
// every cell to 0, so the run ends perfectly clean. Backward consumes the
// output stream in reverse and reproduces the input in reverse.
//
// case: impulse
// in: 1 0 0 0 0 0
// out: 0 0 1 0 1 0
// case: integer_mixing
// in: 5 3 9 0 0 0
// out: 9 3 5 3 12 3
// case: two_generations
// in: 1 2 3 4 5 6
// out: 6 0 4 6 7 4
procedure step(int dst[], int src[])
    iterate int i = 1 to 3
        dst[i] ^= src[i-1] ^ src[i+1]
    end

procedure main()
    int a[5]
    int b[5]
    read b[1]
    read b[2]
    read b[3]
    read a[1]
    read a[2]
    read a[3]
    call step(a, b)
    call step(b, a)
    write b[1]
    write b[2]
    write b[3]
    write a[1]
    write a[2]
    write a[3]
