/* Local struct with array fields: `local struct Box e = a` where Box has a
 * 1-D array field v[3] and a scalar field w.  vjanus uses a flat RL slot with
 * AAsn(OAdd)/AAsn(OSub) instead of Enter/Exit.  Exercises the new lstructs_flat
 * path against PyJanus. */

struct Box {
    int v[3];
    int w;
};

procedure main()
    Box a
    int s

    a.v[0] += 10
    a.v[1] += 20
    a.v[2] += 30
    a.w    += 5

    local struct Box e = a
        s += e.v[0] + e.v[1] + e.v[2] + e.w
    delocal struct Box e = a
