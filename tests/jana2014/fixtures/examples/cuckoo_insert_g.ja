// @summary:   cuckoo hashing with an eviction chain over two tables
// @technique: history-stack
// @source:    gen_janus hard13-15 experiments (2026-07)
// @confirmed: reproduced by tests/jana2014/reference/cuckoo_insert_g.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on k, m, t1, t2, tr
// @keep:      k, t1, t2
// @expect: t1 = 0 5 6 3
// @expect: t2 = 0 0 2 0
// @expect: k = 6
// @expect: tr = 2 5 0
// @expect: m = 2
// @expect: k = 6
// @expect: m = 2
// @expect: t1[4] = {0, 5, 6, 3}
// @expect: t2[4] = {0, 0, 2, 0}
// @expect: tr[3] = {2, 5, 0}
//
// Cuckoo-hash insertion with eviction chain (2 tables x 4 slots, keys 1..9,
// h1(x)=x%4, h2(x)=(x/4+x)%4). Evicted keys are traced in tr; the final
// tables plus (k, tr, m) reverse the chain uniquely.
//
// Contributed from the gen_janus hard13-15 experiments (2026-07):
// solution generated by Claude Opus 4.8 and verified clean against the
// frozen oracle test cases (hidden cases included).

procedure cuckoo_insert(int t1[], int t2[], int k, int tr[], int m)
    local int cur = k, int tbl = 1
        from m = 0 do
            if tbl = 1 then
                if m = 0 then
                    cur <=> t1[k % 4]
                else
                    cur <=> t1[tr[m - 1] % 4]
                fi m = 0
            else
                cur <=> t2[(tr[m - 1] / 4 + tr[m - 1]) % 4]
            fi tbl = 1
            if cur != 0 then
                tr[m] += cur
                m += 1
            else
                skip
            fi cur != 0
        loop
            tbl ^= 3
        until cur = 0
    delocal int cur = 0, int tbl = 1 + m % 2

procedure main()
    int t1[4]
    int t2[4]
    int k
    int tr[3]
    int m

    t1[2] += 2
    t1[3] += 3
    t2[2] += 5
    k += 6

    call cuckoo_insert(t1, t2, k, tr, m)
    // expected: t1=[0, 5, 6, 3], t2=[0, 0, 2, 0], k=6, tr=[2, 5, 0], m=2
    printf("t1 = %d %d %d %d\n", t1[0], t1[1], t1[2], t1[3])
    printf("t2 = %d %d %d %d\n", t2[0], t2[1], t2[2], t2[3])
    printf("k = %d\n", k)
    printf("tr = %d %d %d\n", tr[0], tr[1], tr[2])
    printf("m = %d\n", m)
