// @summary:   three ways to write Fibonacci reversibly, on the same n
// @technique: clean-accumulation
// @source:    Sarah Vang Nohr, Reversible-Graph-Algorithms-Janus- (fibonacci.janus), github.com/Ekima; the code of the bachelor's project cited by binary_heap_g
// @confirmed: reproduced by tests/jana2014/reference/fib_variants_c.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on an, ar, ax1, ax2, bn, br, bx1, bx2, n, x1, x2
// @keep:      an, ar, br, x1, x2
// @expect: fib  pair: x1=5 x2=8
// @expect: fiba: r=5 n=4 x1=0 x2=0
// @expect: fibb: r=5 n=0 x1=0 x2=0
// @expect: an = 4
// @expect: ar = 5
// @expect: ax1 = 0
// @expect: ax2 = 0
// @expect: bn = 0
// @expect: br = 5
// @expect: bx1 = 0
// @expect: bx2 = 0
// @expect: n = 0
// @expect: x1 = 5
// @expect: x2 = 8
//
// Three reversible Fibonacci implementations.
//
// Adapted from Ekima's reversible-graph-algorithms repository
// (fibonacci.janus,
// https://github.com/Ekima/Reversible-Graph-Algorithms-Janus-).
//
// Demonstrates three styles of reversible computation:
//
//   fib   - recursive: leaves the successive Fibonacci pair (x1, x2) =
//           (F(n), F(n+1)) in the inputs. NOT garbage-free.
//   fiba  - wrapper that uses `uncall fib` to recover the inputs after
//           extracting a single result `r`. Returns r and restores n,x1,x2.
//   fibb  - iterative, fully garbage-free: writes the result to `r` and
//           explicitly uncomputes the loop and accumulators so that n, x1,
//           and x2 are all zero again on exit. This is the textbook Bennett
//           "compute-then-uncompute" pattern.
//
// Uses the indexing F(0)=F(1)=1, F(2)=2, F(3)=3, F(4)=5, ...

procedure fib(int n, int x1, int x2)
    if n = 0 then
        x1 += 1
        x2 += 1
    else
        n -= 1
        call fib(n, x1, x2)
        x1 += x2
        x1 <=> x2
    fi x1 = x2

procedure fiba(int r, int n, int x1, int x2)
    call fib(n, x1, x2)
    r += x1
    uncall fib(n, x1, x2)

procedure fibb(int r, int n, int x1, int x2)
    x1 += 1
    x2 += 1
    local int i = 0
    from i = 0 do
        x1 += x2
        x1 <=> x2
        i += 1
    until i = n
    delocal int i = n
    r += x1
    from x1 = r do
        x1 <=> x2
        x1 -= x2
        n -= 1
    until x1 = x2
    x1 -= 1
    x2 -= 1

procedure main()
    int n
    int x1
    int x2

    int ar
    int an
    int ax1
    int ax2

    int br
    int bn
    int bx1
    int bx2

    n += 4
    call fib(n, x1, x2)
    printf("fib  pair: x1=%d x2=%d\n", x1, x2)

    an += 4
    call fiba(ar, an, ax1, ax2)
    printf("fiba: r=%d n=%d x1=%d x2=%d\n", ar, an, ax1, ax2)

    bn += 4
    call fibb(br, bn, bx1, bx2)
    printf("fibb: r=%d n=%d x1=%d x2=%d\n", br, bn, bx1, bx2)
