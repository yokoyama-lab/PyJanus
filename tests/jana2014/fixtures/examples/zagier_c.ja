// @summary:   zagier's involution on triples with x^2 + 4yz fixed -- the one-sentence proof that a prime 1 mod 4 is a sum of two squares
// @technique: plain
// @source:    D. Zagier, A one-sentence proof that every prime p = 1 mod 4 is a sum of two squares, Amer. Math. Monthly 97(2), 1990
// @confirmed: reproduced by tests/jana2014/reference/zagier_c.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on x, y, z
// @keep:      x, y, z
// @expect: x = 1
// @expect: y = 9
// @expect: z = 1
// @expect: x = 1
// @expect: y = 9
// @expect: z = 1
//
// Zagier's windmill involution from the one-sentence proof of Fermat's
// two-squares theorem, on x^2+4yz=p. The exit assertions encode the theorem
// (outer branches swap, middle branch is fixed).
//
// Contributed from the gen_janus hard13-15 experiments (2026-07):
// solution generated by Claude Opus 4.8 and verified clean against the
// frozen oracle test cases (hidden cases included).

procedure zagier(int x, int y, int z)
    if x < y - z then
        x += 2 * z
        y <=> z
        z -= x - y
    else
        if x < 2 * y then
            x -= 2 * y
            x *= -1
            z += y - x
        else
            x -= 2 * y
            y <=> z
            y += x + z
        fi !(x < y - z)
    fi x >= 2 * y

procedure main()
    int x
    int y
    int z

    x += 3
    y += 1
    z += 7

    call zagier(x, y, z)
    // expected: x=1, y=9, z=1
    printf("x = %d\n", x)
    printf("y = %d\n", y)
    printf("z = %d\n", z)
