// Arrays of structs: element field access `v[i].f`, cross-element field
// arithmetic, and a field swap across elements.  Exercises vjanus's
// struct-array lowering (cell index = element*nfields + field offset).

struct Pair {
    int a;
    int b;
};

procedure main()
    Pair v[3]

    v[0].a += 1
    v[0].b += 2
    v[1].a += 3
    v[1].b += 4
    v[2].a += 5

    // read fields of other elements
    v[2].b += v[0].a + v[1].b      // 1 + 4 = 5

    // swap a field across two elements
    v[0].a <=> v[1].b              // v[0].a = 4, v[1].b = 1
