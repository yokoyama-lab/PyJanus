// @summary:   arithmetic coding of a bit string, then decoded again
// @technique: plain
// @source:    J. Duda, asymmetric numeral systems; cf. docs/reversible-pearls.md Tier 2
// @confirmed: reproduced by tests/jana2014/reference/arith_coding_c.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on m, n, q, r, x
// @keep:      m, n
// @expect: encoded:   x=25   msg=0000  (q=0 r=0)
// @expect: decoded:   msg=1010   x=0  (q=0 r=0)
// @expect: m[4] = {1, 0, 1, 0}
// @expect: n = 4
// @expect: q = 0
// @expect: r = 0
// @expect: x = 0
//
// Level 9: integer arithmetic coding, done as a bijective range-ANS (rANS) coder.
//
// Arithmetic coding folds a message over a probability model into a single
// integer. The asymmetric numeral system (Duda) makes that fold an EXACT
// bijection on the integer state x, so the decoder is literally the encoder run
// backwards -- which in Janus means the decoder is `uncall encode`, derived for
// free. This is the calculational "invert the coder" pearl that the reversible
// language embodies directly.
//
// Binary model: symbol 0 has frequency f0 = 3, symbol 1 has f1 = 1, total
// M = 4, cumulatives C0 = 0, C1 = 3. The rANS encoding step is the state map
//
//     x  |->  (x / f_s) * M + C_s + (x mod f_s)
//
// a bijection whose inverse reads the symbol back from the low slot x mod M:
// slot in [C_s, C_s + f_s) identifies s. We realise the step with NO destructive
// `/=` or `*=` (the verified cores have only += / -= / ^=): a value-preserving
// divmod splits x into (q, r) using `/` and `%` as pure expressions, then the
// mirror image rebuilds the new state and drives the q, r ancillas back to 0:
//
//     q += x / f ;  r += x % f ;  x -= q*f + r        // x := 0, (q,r) hold x
//     x += q*M ;    x += C + r                          // x := q*M + C + r
//     q -= x / M ;  r -= x % M - C                      // q,r := 0 again
//
// The if-fi over the symbol closes on `x mod M < f0`, the slot test that the
// decoder uses to recover s -- so each comparator-like step, and the whole
// coder, is reversible. The message is CONSUMED into x (every m[i] ends 0); the
// backward run reconstructs it and clears x back to 0.

procedure encode_sym(int x, int m, int q, int r)
    if m = 0 then
        // symbol 0: f = 3, C = 0
        q += x / 3
        r += x % 3
        x -= q * 3 + r
        x += q * 4
        x += r
        q -= x / 4
        r -= x % 4
    else
        // symbol 1: f = 1, C = 3 (r stays 0 since x % 1 = 0)
        q += x
        x -= q
        x += q * 4
        x += 3
        q -= x / 4
        m -= 1
    fi x % 4 < 3

procedure encode(int m[], int n, int x, int q, int r)
    local int i = 0
        from i = 0 loop
            call encode_sym(x, m[i], q, r)
            i += 1
        until i = n
    delocal int i = n

procedure main()
    int m[4] = {1, 0, 1, 0}
    int n
    int x
    int q
    int r

    n += 4

    // Encode: fold the message into the single integer state x.
    //   x: 0 -(1)-> 3 -(0)-> 4 -(1)-> 19 -(0)-> 25
    call encode(m, n, x, q, r)
    printf("encoded:   x=%d   msg=%d%d%d%d  (q=%d r=%d)\n",
           x, m[0], m[1], m[2], m[3], q, r)

    // Decode = uncall: read the symbols back out of x, leaving x = 0.
    uncall encode(m, n, x, q, r)
    printf("decoded:   msg=%d%d%d%d   x=%d  (q=%d r=%d)\n",
           m[0], m[1], m[2], m[3], x, q, r)
