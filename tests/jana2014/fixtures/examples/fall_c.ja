// @summary:   free fall in integer steps: each tick the body gains g of speed and falls the average of its speed before and after (g*t + g/2)
// @technique: plain
// @source:    Ekima, Reversible-Graph-Algorithms-Janus- (fall.janus)
// @confirmed: reproduced by tests/jana2014/reference/fall_c.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on g, h, h_r, t, t_end, t_end_r, t_r, v, v_r
// @keep:      g, h, h_r, t, t_end, t_end_r, v
// @expect: h_r = 80
// @expect: g = 10
// @expect: h = 131
// @expect: h_r = 80
// @expect: t = 3
// @expect: t_end = 3
// @expect: t_end_r = 4
// @expect: t_r = 0
// @expect: v = 30
// @expect: v_r = 0
//
// Discrete simulation of a free-falling body.
//
// Adapted from Ekima's reversible-graph-algorithms repository (fall.janus,
// https://github.com/Ekima/Reversible-Graph-Algorithms-Janus-), which uses
// the same standard jana2014 dialect as this fixture.
//
// Variables:
//   g     gravitational acceleration
//   t     elapsed time
//   v     velocity
//   h     height
//   t_end duration of the simulation
//
// `call fall` runs the simulation forward. The companion `uncall fall` runs
// the inverse simulation, recovering the initial height from a known final
// state.

procedure fall(int g, int t, int v, int h, int t_end)
    local int halfg = g / 2
    from t = 0 do
        v += g
        h -= v
        h += halfg
        t += 1
    until t = t_end
    delocal int halfg = g / 2

procedure main()
    int g
    int t
    int v
    int h
    int t_end

    int t_r
    int v_r
    int h_r
    int t_end_r

    g += 10

    h += 176
    t_end += 3

    call fall(g, t, v, h, t_end)

    t_r += 4
    v_r += 40
    t_end_r += 4

    uncall fall(g, t_r, v_r, h_r, t_end_r)
    printf("h_r = %d\n", h_r)
