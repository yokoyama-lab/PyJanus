// @summary:   binary search returning the lower bound, built one bit at a time with one ancilla per probe
// @technique: ancilla-flag
// @source:    classical binary search; the bit-at-a-time formulation with one ancilla per probe is original
// @confirmed: reproduced by tests/jana2014/reference/binary_search_g.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on a, idx, key
// @keep:      a, idx, key
// @expect: a[8] = {2, 3, 5, 7, 11, 13, 17, 19}
// @expect: flags[3] = {1, 0, 1}
// @expect: idx = 5
// @expect: key = 13
//
// Binary search that builds the answer index one bit at a time.
//
// Each probe halves the range by deciding `a[idx + b - 1] < key`, and that
// decision cannot be recovered afterwards -- idx has already moved -- so it is
// recorded in one ancilla bit per probe, which is also what the `fi` exit
// assertion tests.  The probe widths 4, 2, 1 are a fixed schedule, not data.

procedure probe(int a[], int key, int idx, int b, int flags[], int k)
    if a[idx + b - 1] < key then
        flags[k] += 1
    else
        skip
    fi flags[k] = 1

    if flags[k] = 1 then
        idx += b
    else
        skip
    fi flags[k] = 1

procedure bsearch8(int a[], int key, int idx, int flags[])
    call probe(a, key, idx, 4, flags, 0)
    call probe(a, key, idx, 2, flags, 1)
    call probe(a, key, idx, 1, flags, 2)

procedure main()
    int a[8]
    int key
    int idx
    int flags[3]

    a[0] += 2   a[1] += 3   a[2] += 5   a[3] += 7
    a[4] += 11  a[5] += 13  a[6] += 17  a[7] += 19
    key += 13

    call bsearch8(a, key, idx, flags)
