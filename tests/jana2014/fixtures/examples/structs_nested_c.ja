// @summary:   accumulate(p, q) does p += 2q + something; called, uncalled, called again, so the net effect is one application
// @technique: clean-accumulation
// @source:    original (a fixture for nested struct-by-reference calls)
// @confirmed: reproduced by tests/jana2014/reference/structs_nested_c.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on p, q
// @keep:      p, q
// @expect: p = {x = 21, y = 42}
// @expect: q = {x = 10, y = 20}
//
// Nested struct-by-reference: a procedure passes its OWN struct formals onward
// to a second procedure, so the per-field ref expansion happens at a nested
// (non-main) call site (vjanus's struct_var_field_refs via the `fstructs`
// table, not `gstructs`).  The whole composite is then run backwards with
// `uncall`, exercising the reverse lowering of a nested by-reference struct
// call.  Checked against PyJanus.

struct Vec {
    int x;
    int y;
};

procedure addv(Vec a, Vec b)        // a += b, componentwise
    a.x += b.x
    a.y += b.y

procedure accumulate(Vec acc, Vec d)
    call addv(acc, d)               // passes its own struct formals onward
    call addv(acc, d)               // acc += 2*d

procedure main()
    Vec p
    Vec q

    p.x += 1
    p.y += 2
    q.x += 10
    q.y += 20

    call accumulate(p, q)           // p = {21, 42}
    uncall accumulate(p, q)         // p back to {1, 2}
    call accumulate(p, q)           // p = {21, 42}
