// @summary:   integer square root: the root, with the remainder left in place of the input
// @technique: plain
// @source:    C. Lutz and H. Derby, Janus: a time-reversible language
// @confirmed: reproduced by tests/jana2014/reference/sqrt_g.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on num, root
// @keep:      root
// @expect: 66 0
// @expect: 2 8
// @expect: num = 2
// @expect: root = 8
//
// Calculating the square root of an integer.
// Adapted version of example from "Janus: a time-reversible language" by
// C. Lutz and H. Derby.

procedure doublebit(int bit)
    local int z = bit
    bit += z
    delocal int z = bit / 2

// Calculates floor(sqrt(num))
procedure root(int num, int root)
    local int bit = 1
    from bit = 1 loop  // find exponential ball park
        call doublebit(bit)
    until (bit * bit) > num

    from (bit * bit) > num do
        uncall doublebit(bit)
        if ((root + bit) * (root + bit)) <= num then
            root += bit
        fi (root / bit) % 2 != 0
    until bit = 1
    delocal int bit = 1
    num -= root * root

procedure main()
    int num
    int root

    num += 66
    printf("%d %d \n", num, root)
    call root(num, root)
    printf("%d %d \n", num, root)
    /*
    root += 25
    uncall root(num, root)
    */
