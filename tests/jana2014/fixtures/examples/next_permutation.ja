//////////////////////////////////////////////////////////////////////
// Reversible Next Permutation (lexicographic successor)
//
// Rewrite of the historical known-broken version, which tried to
// un-compute the pivot indices against the ALREADY-MUTATED array.
// Here the two index searches are performed cleanly on the original
// array (each search's scan variable is delocalised against the copied
// result, so the searches leave no garbage), and after the swap +
// suffix reversal the two indices -- which are NOT recoverable from
// the successor permutation alone -- are logged on `glog` (2 words per
// call, the paper-style "complete logging" of exactly the destroyed
// information).
// Precondition: p is not the lexicographically last (descending)
// permutation.
//   forward: p -> next permutation of p;  glog gains (j, i)
//   uncall : restores the previous permutation.
//////////////////////////////////////////////////////////////////////

// ii := largest index with p[ii] < p[ii+1]  (clean: no garbage)
procedure find_pivot(int p[], int n, int ii)
  local int k = n - 2
    from  k = n - 2
    loop  k -= 1
    until p[k] < p[k+1]
    ii ^= k
  delocal int k = ii

// jj := largest index > pivot i with p[jj] > p[i]  (clean)
procedure find_succ(int p[], int n, int i, int jj)
  local int k = n - 1
    from  k = n - 1
    loop  k -= 1
    until p[k] > p[i]
    jj ^= k
  delocal int k = jj

procedure next_perm(int p[], int n, stack glog)
  local int i = 0
    call find_pivot(p,n,i)
    local int j = 0
      call find_succ(p,n,i,j)
      local int t = p[i] ^ p[j]     // p[i] <=> p[j] (indices differ)
        p[i] ^= t
        p[j] ^= t
      delocal int t = p[i] ^ p[j]
      push(j,glog)                  // j is not recoverable afterwards
    delocal int j = 0
    // reverse the suffix p[i+1 .. n-1]
    local int k = 0
      from  k = 0
      loop  local int t = p[i+1+k] ^ p[n-1-k]
              p[i+1+k] ^= t
              p[n-1-k] ^= t
            delocal int t = p[i+1+k] ^ p[n-1-k]
            k += 1
      until k = (n-1-i)/2
    delocal int k = (n-1-i)/2
    push(i,glog)                    // i is not recoverable afterwards
  delocal int i = 0

procedure main()
  int d[8]
  int n
  stack glog

  n += 8
  d[0] += 6
  d[1] += 7
  d[2] += 3
  d[3] += 5
  d[4] += 4
  d[5] += 2
  d[6] += 1
  d[7] += 0

  call next_perm(d,n,glog)
  // successor of 6 7 3 5 4 2 1 0  is  6 7 4 0 1 2 3 5
