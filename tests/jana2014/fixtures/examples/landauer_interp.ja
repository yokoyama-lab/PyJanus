//////////////////////////////////////////////////////////////////////
// Landauer embedding of an irreversible mini-language: destructive
// instructions trace exactly the overwritten value; reversible ones trace 0.
//
// Contributed from the gen_janus hard13-15 experiments (2026-07):
// solution generated by Claude Opus 4.8 and verified clean against the
// frozen oracle test cases (hidden cases included).
//////////////////////////////////////////////////////////////////////

procedure landauer_interp(int p[], int L, int a, int b, int tr[])
    local int i = 0
    from i = 0 do
        if p[i] = 1 then
            a <=> tr[i]
            a += b
        else
            if p[i] = 2 then
                b <=> tr[i]
                b += a
            else
                if p[i] = 3 then
                    a += 1
                    if a = 4 then
                        a -= 4
                    else
                        skip
                    fi a = 0
                else
                    a <=> b
                fi p[i] = 3
            fi p[i] = 2
        fi p[i] = 1
        i += 1
    loop skip
    until i = L
    delocal int i = L

procedure main()
    int p[3]
    int L
    int a
    int b
    int tr[3]

    p[0] += 1
    p[1] += 3
    p[2] += 2
    L += 3
    a += 2
    b += 1

    call landauer_interp(p, L, a, b, tr)
    // expected: p=[1, 3, 2], L=3, a=2, b=2, tr=[2, 0, 1]
    printf("p = %d %d %d\n", p[0], p[1], p[2])
    printf("L = %d\n", L)
    printf("a = %d\n", a)
    printf("b = %d\n", b)
    printf("tr = %d %d %d\n", tr[0], tr[1], tr[2])
