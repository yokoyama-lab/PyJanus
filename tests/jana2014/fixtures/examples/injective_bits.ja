/*
 * A second level of reversible injective procedures, focused on bit-level
 * operations and a one-round Feistel network.
 *
 * Because every Janus procedure is bijective on its state, `uncall p(...)`
 * inverts `call p(...)` automatically. For the Gray-code and Feistel
 * examples we exercise the inverse by `uncall` rather than writing a
 * separate decode procedure.
 *
 *   1. xor_key       x -> x XOR k          (involution)
 *   2. xor_into      (x, y) -> (x, y XOR x) (involution; x preserved)
 *   3. gray_encode   (x, g) -> (x, g XOR x XOR (x >> 1))
 *                    g starts at 0, so g ends as the Gray code of x.
 *   4. feistel_round (L, R, K) -> (R, L XOR (R * K))
 *                    one round of a Feistel network with key K.
 */

procedure xor_key(int x, int k)
    x ^= k

procedure xor_into(int x, int y)
    y ^= x

// Binary-to-Gray encoding: g <- g XOR x XOR (x >> 1).
// Caller passes g=0; on exit g holds Gray(x), x preserved.
procedure gray_encode(int x, int g)
    g ^= x
    g ^= x / 2

// One Feistel round with round function f(R) = R * K.
// (L, R) -> (R, L XOR f(R)). Bijective.
procedure feistel_round(int L, int R, int K)
    local int t = R * K
        L ^= t
    delocal int t = R * K
    L <=> R

procedure main()
    int a
    int k
    int x
    int y
    int gx
    int g
    int L
    int R
    int K

    // 1. xor_key: 12 XOR 10 = 6 (0b1100 ^ 0b1010 = 0b0110)
    a += 12
    k += 10
    call xor_key(a, k)
    printf("xor_key:    a=%d (k=%d)\n", a, k)
    // Applying the same key twice returns to the original (involution).
    call xor_key(a, k)
    printf("xor_key x2: a=%d\n", a)

    // 2. xor_into: y=255 (0xFF) XOR x=240 (0xF0) = 15 (0x0F)
    y += 255
    x += 240
    call xor_into(x, y)
    printf("xor_into:   x=%d y=%d\n", x, y)

    // 3. gray_encode: 12 -> Gray(12) = 12 XOR 6 = 10 (0b1100 ^ 0b0110)
    gx += 12
    call gray_encode(gx, g)
    printf("gray_enc:   gx=%d g=%d\n", gx, g)
    // uncall is the Gray-to-binary decoder: it clears g back to 0.
    uncall gray_encode(gx, g)
    printf("gray_dec:   gx=%d g=%d\n", gx, g)

    // 4. feistel_round: (L=5, R=7, K=3)
    //    f(R) = R*K = 21; L XOR 21 = 5 XOR 21 = 16; then swap.
    //    -> (L=7, R=16)
    L += 5
    R += 7
    K += 3
    call feistel_round(L, R, K)
    printf("feistel:    L=%d R=%d (K=%d)\n", L, R, K)
    // Round-trip: uncall restores the input.
    uncall feistel_round(L, R, K)
    printf("feistel^-1: L=%d R=%d\n", L, R)
