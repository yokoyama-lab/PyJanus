// @summary:   the Ackermann function at (2,2), with both arguments left intact
// @technique: bennett-uncompute
// @source:    W. Ackermann, Zum Hilbertschen Aufbau der reellen Zahlen, Math. Ann. 99, 1928; the compute-uncompute formulation is original
// @confirmed: reproduced by tests/jana2014/reference/ackermann_c.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on m, n, r
// @keep:      m, n, r
// @expect: m = 2
// @expect: n = 2
// @expect: r = 7
//
// The Ackermann function, computed reversibly by compute-use-uncompute.
//
//   A(0, n) = n + 1
//   A(m, 0) = A(m-1, 1)
//   A(m, n) = A(m-1, A(m, n-1))
//
// The third case needs the inner value A(m, n-1) to reach the outer call, and
// once the outer call has produced its answer that inner value is no longer
// wanted -- but it is a function of (m, n-1), so it can be recomputed away
// rather than logged. Both nested calls are undone by `uncall`, leaving only
// the result and the two arguments, which the recursion restores as it unwinds.
//
// A(2,2) is as far as this goes: uncomputing doubles the depth of the
// recursion, and A(2,3) overruns the interpreter's Python stack -- the same
// limit that makes infinite-recursion.ja the one error fixture escaping the
// diagnostic machinery.

procedure ack(int m, int n, int r)
    if m = 0 then
        r += n + 1
    else
        if n = 0 then
            m -= 1
            local int one = 1
                local int t = 0
                    call ack(m, one, t)
                    r += t
                    uncall ack(m, one, t)
                delocal int t = 0
            delocal int one = 1
            m += 1
        else
            n -= 1
            local int inner = 0
                call ack(m, n, inner)
                m -= 1
                local int outer = 0
                    call ack(m, inner, outer)
                    r += outer
                    uncall ack(m, inner, outer)
                delocal int outer = 0
                m += 1
                uncall ack(m, n, inner)
            delocal int inner = 0
            n += 1
        fi n = 0
    fi m = 0

procedure main()
    int m
    int n
    int r

    m += 2
    n += 2
    call ack(m, n, r)
