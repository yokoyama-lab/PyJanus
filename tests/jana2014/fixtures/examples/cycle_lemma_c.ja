// @summary:   dvoretzky and Motzkin's cycle lemma
// @technique: ancilla-flag
// @source:    Dvoretzky and Motzkin cycle lemma; gen_janus hard13-15 experiments (2026-07)
// @confirmed: reproduced by tests/jana2014/reference/cycle_lemma_c.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on a, n, r
// @keep:      a, n, r
// @expect: a = 1 1 -1 1 -1
// @expect: n = 5
// @expect: r = 1
// @expect: a[5] = {1, 1, -1, 1, -1}
// @expect: n = 5
// @expect: r = 1
//
// Cycle lemma (Dvoretzky-Motzkin) normalization: the unique rotation making
// all prefix sums positive. Injectivity IS the uniqueness theorem.
//
// Contributed from the gen_janus hard13-15 experiments (2026-07):
// solution generated by Claude Opus 4.8 and verified clean against the
// frozen oracle test cases (hidden cases included).

procedure check(int a[], int n, int k, int ok)
    local int s = 0
    local int i = 0
    local int bad = 0
        from i = 0 do
            s += a[(i + k) % n]
            bad += (s < 1)
        loop
            i += 1
        until i = n - 1
        ok += (bad = 0)
        from i = n - 1 do
            bad -= (s < 1)
            s -= a[(i + k) % n]
        loop
            i -= 1
        until i = 0
    delocal int bad = 0
    delocal int i = 0
    delocal int s = 0

procedure rot1(int a[], int n)
    local int i = 0
        from i = 0 do
            a[i] <=> a[i + 1]
        loop
            i += 1
        until i = n - 2
    delocal int i = n - 2

procedure cycle_lemma(int a[], int n, int r)
    local int k = 0
        from k = 0 do
            local int ok = 0
                call check(a, n, k, ok)
                r += k * ok
                uncall check(a, n, k, ok)
            delocal int ok = 0
        loop
            k += 1
        until k = n - 1
    delocal int k = n - 1
    local int j = 0
        from j = 0 do
            skip
        loop
            call rot1(a, n)
            j += 1
        until j = r
    delocal int j = r

procedure main()
    int a[5]
    int n
    int r

    a[0] -= 1
    a[1] += 1
    a[2] += 1
    a[3] -= 1
    a[4] += 1
    n += 5

    call cycle_lemma(a, n, r)
    // expected: a=[1, 1, -1, 1, -1], n=5, r=1
    printf("a = %d %d %d %d %d\n", a[0], a[1], a[2], a[3], a[4])
    printf("n = %d\n", n)
    printf("r = %d\n", r)
