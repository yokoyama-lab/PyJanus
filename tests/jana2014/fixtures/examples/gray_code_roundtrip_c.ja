// @summary:   gray-encode then decode: the input comes back
// @technique: plain
// @source:    reflected binary Gray code
// @confirmed: reproduced by tests/jana2014/reference/gray_code_roundtrip_c.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on bits
// @keep:      bits
// @expect: bits[4] = {0, 1, 0, 1}
//
// Gray code is its own inverse pair: `call gray` encodes, `uncall gray` decodes,
// and the composition is the identity. This fixture bakes a binary vector into
// main, encodes it to Gray, then decodes it back — the final store must equal
// the initial one (bits = 1010, i.e. bits[3] and bits[1] set). The verified
// vjanus interpreter and PyJanus are diffed on this by test_vjanus_corpus.py,
// pinning encode/decode reversibility through the Coq-extracted `run`.

procedure gray(int bits[])
    iterate int i = 0 to 2
        bits[i] ^= bits[i+1]
    end

procedure main()
    int bits[4]
    bits[3] += 1
    bits[1] += 1
    call gray(bits)
    uncall gray(bits)
