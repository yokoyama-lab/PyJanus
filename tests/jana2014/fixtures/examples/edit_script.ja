//////////////////////////////////////////////////////////////////////
// Levenshtein distance consuming BOTH strings; a symbol-carrying edit script
// in tr is the invented injective embedding (a script without symbols is not
// enough to recover the inputs).
//
// Contributed from the gen_janus hard13-15 experiments (2026-07):
// solution generated by Claude Opus 4.8 and verified clean against the
// frozen oracle test cases (hidden cases included).
//////////////////////////////////////////////////////////////////////

procedure mincell(int up, int left, int diag, int c, int out)
  local int u = up + 1, int l = left + 1, int dg = diag + c
    if u <= l && u <= dg then
      out += u
    else
      if l <= dg then
        out += l
      else
        out += dg
      fi out = l
    fi out = u
  delocal int u = up + 1, int l = left + 1, int dg = diag + c

procedure fill(int tr[], int m, int n, int a00, int a01, int a02, int a03, int a10, int a11, int a12, int a13, int a20, int a21, int a22, int a23, int a30, int a31, int a32, int a33)
  if m >= 1 then a10 += 1 else skip fi m >= 1
  if m >= 2 then a20 += 2 else skip fi m >= 2
  if m >= 3 then a30 += 3 else skip fi m >= 3
  if n >= 1 then a01 += 1 else skip fi n >= 1
  if n >= 2 then a02 += 2 else skip fi n >= 2
  if n >= 3 then a03 += 3 else skip fi n >= 3

  if m >= 1 && n >= 1 then
    local int c = (tr[0] != tr[3])
      call mincell(a01, a10, a00, c, a11)
    delocal int c = (tr[0] != tr[3])
  else skip fi m >= 1 && n >= 1

  if m >= 1 && n >= 2 then
    local int c = (tr[0] != tr[4])
      call mincell(a02, a11, a01, c, a12)
    delocal int c = (tr[0] != tr[4])
  else skip fi m >= 1 && n >= 2

  if m >= 1 && n >= 3 then
    local int c = (tr[0] != tr[5])
      call mincell(a03, a12, a02, c, a13)
    delocal int c = (tr[0] != tr[5])
  else skip fi m >= 1 && n >= 3

  if m >= 2 && n >= 1 then
    local int c = (tr[1] != tr[3])
      call mincell(a11, a20, a10, c, a21)
    delocal int c = (tr[1] != tr[3])
  else skip fi m >= 2 && n >= 1

  if m >= 2 && n >= 2 then
    local int c = (tr[1] != tr[4])
      call mincell(a12, a21, a11, c, a22)
    delocal int c = (tr[1] != tr[4])
  else skip fi m >= 2 && n >= 2

  if m >= 2 && n >= 3 then
    local int c = (tr[1] != tr[5])
      call mincell(a13, a22, a12, c, a23)
    delocal int c = (tr[1] != tr[5])
  else skip fi m >= 2 && n >= 3

  if m >= 3 && n >= 1 then
    local int c = (tr[2] != tr[3])
      call mincell(a21, a30, a20, c, a31)
    delocal int c = (tr[2] != tr[3])
  else skip fi m >= 3 && n >= 1

  if m >= 3 && n >= 2 then
    local int c = (tr[2] != tr[4])
      call mincell(a22, a31, a21, c, a32)
    delocal int c = (tr[2] != tr[4])
  else skip fi m >= 3 && n >= 2

  if m >= 3 && n >= 3 then
    local int c = (tr[2] != tr[5])
      call mincell(a23, a32, a22, c, a33)
    delocal int c = (tr[2] != tr[5])
  else skip fi m >= 3 && n >= 3

procedure edit_script(int s[], int m, int t[], int n, int d, int tr[])
  if m >= 1 then
    tr[0] += s[0]
    s[0] -= tr[0]
  else skip fi m >= 1
  if m >= 2 then
    tr[1] += s[1]
    s[1] -= tr[1]
  else skip fi m >= 2
  if m >= 3 then
    tr[2] += s[2]
    s[2] -= tr[2]
  else skip fi m >= 3

  if n >= 1 then
    tr[3] += t[0]
    t[0] -= tr[3]
  else skip fi n >= 1
  if n >= 2 then
    tr[4] += t[1]
    t[1] -= tr[4]
  else skip fi n >= 2
  if n >= 3 then
    tr[5] += t[2]
    t[2] -= tr[5]
  else skip fi n >= 3

  local int a00 = 0, int a01 = 0, int a02 = 0, int a03 = 0, int a10 = 0, int a11 = 0, int a12 = 0, int a13 = 0, int a20 = 0, int a21 = 0, int a22 = 0, int a23 = 0, int a30 = 0, int a31 = 0, int a32 = 0, int a33 = 0
    call fill(tr, m, n, a00, a01, a02, a03, a10, a11, a12, a13, a20, a21, a22, a23, a30, a31, a32, a33)

    if m = 1 then
      if n = 1 then
        d += a11
      else
        if n = 2 then
          d += a12
        else
          d += a13
        fi n = 2
      fi n = 1
    else
      if m = 2 then
        if n = 1 then
          d += a21
        else
          if n = 2 then
            d += a22
          else
            d += a23
          fi n = 2
        fi n = 1
      else
        if n = 1 then
          d += a31
        else
          if n = 2 then
            d += a32
          else
            d += a33
          fi n = 2
        fi n = 1
      fi m = 2
    fi m = 1

    uncall fill(tr, m, n, a00, a01, a02, a03, a10, a11, a12, a13, a20, a21, a22, a23, a30, a31, a32, a33)
  delocal int a00 = 0, int a01 = 0, int a02 = 0, int a03 = 0, int a10 = 0, int a11 = 0, int a12 = 0, int a13 = 0, int a20 = 0, int a21 = 0, int a22 = 0, int a23 = 0, int a30 = 0, int a31 = 0, int a32 = 0, int a33 = 0

procedure main()
    int s[3]
    int m
    int t[2]
    int n
    int d
    int tr[6]

    s[0] += 1
    s[1] += 2
    s[2] += 1
    m += 3
    t[0] += 2
    t[1] += 1
    n += 2

    call edit_script(s, m, t, n, d, tr)
    // expected: s=[0, 0, 0], t=[0, 0], m=3, n=2, d=1
    printf("s = %d %d %d\n", s[0], s[1], s[2])
    printf("m = %d\n", m)
    printf("t = %d %d\n", t[0], t[1])
    printf("n = %d\n", n)
    printf("d = %d\n", d)
    printf("tr = %d %d %d %d %d %d\n", tr[0], tr[1], tr[2], tr[3], tr[4], tr[5])
