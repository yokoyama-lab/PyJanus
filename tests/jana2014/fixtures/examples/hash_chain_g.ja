// @summary:   four iterations of the non-injective map f(v) = (v*v + 1) mod 16
// @technique: history-stack
// @source:    gen_janus hard13-15 experiments (2026-07)
// @confirmed: reproduced by tests/jana2014/reference/hash_chain_g.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on x
// @keep:      x
// @expect: x = 5
// @expect: tr = 1 2 1 2
// @expect: tr[4] = {1, 2, 1, 2}
// @expect: x = 5
//
// Consuming iteration of the non-injective map f(v)=(v*v+1)%16: x := f^4(x).
// Each step banks only a preimage index (< 4) -- the input itself does not fit.
//
// Contributed from the gen_janus hard13-15 experiments (2026-07):
// solution generated by Claude Opus 4.8 and verified clean against the
// frozen oracle test cases (hidden cases included).

procedure step(int x, int tr[], int i)
    tr[i] += x / 4
    local int m = x % 8
        x -= 4 * tr[i] + m % 4
        x += 1 + (m = 1 || m = 7) + 4 * (m = 2 || m = 6) + 9 * (m = 3 || m = 5)
    delocal int m = (x = 1) * 4 * (tr[i] % 2)
                  + (x = 2) * (1 + 6 * (tr[i] % 2))
                  + (x = 5) * (2 + 4 * (tr[i] % 2))
                  + (x = 10) * (3 + 2 * (tr[i] % 2))

procedure hash_chain(int x, int tr[])
    call step(x, tr, 0)
    call step(x, tr, 1)
    call step(x, tr, 2)
    call step(x, tr, 3)

procedure main()
    int x
    int tr[4]

    x += 5

    call hash_chain(x, tr)
    // expected: x=5
    printf("x = %d\n", x)
    printf("tr = %d %d %d %d\n", tr[0], tr[1], tr[2], tr[3])
