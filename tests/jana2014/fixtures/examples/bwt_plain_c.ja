// @summary:   burrows-Wheeler transform: last column of the sorted rotations, plus the index the original string landed at
// @technique: plain
// @source:    gen_janus hard13-15 experiments (2026-07)
// @confirmed: reproduced by tests/jana2014/reference/bwt_plain_c.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on L, n, primary, s
// @keep:      L, n
// @expect: s = 0 0 0 0 0 0
// @expect: n = 6
// @expect: L = 2 2 2 1 1 1
// @expect: primary = 0
// @expect: L[6] = {2, 2, 2, 1, 1, 1}
// @expect: n = 6
// @expect: primary = 0
// @expect: s[6] = {0, 0, 0, 0, 0, 0}
//
// Sentinel-free Burrows-Wheeler transform with stable tie-break: injective
// even for periodic sources by the BWT invertibility theorem (LF mapping).
//
// Contributed from the gen_janus hard13-15 experiments (2026-07):
// solution generated by Claude Opus 4.8 and verified clean against the
// frozen oracle test cases (hidden cases included).

procedure firstdiff(int s[], int n, int j, int i, int p, int d)
    local int k = 0
        from k = 0 do
            skip
        loop
            if p = 0 && s[(j + k) % n] != s[(i + k) % n] then
                d += s[(j + k) % n] - s[(i + k) % n]
                p += k + 1
            else
                skip
            fi p = k + 1
            k += 1
        until k = n
    delocal int k = n

procedure cmprot(int s[], int n, int j, int i, int c)
    local int p = 0, int d = 0
        call firstdiff(s, n, j, i, p, d)
        if d < 0 then
            c += 1
        else
            if d = 0 && j < i then
                c += 1
            else
                skip
            fi d = 0 && j < i
        fi d < 0
        uncall firstdiff(s, n, j, i, p, d)
    delocal int p = 0, int d = 0

procedure rankof(int s[], int n, int i, int r)
    local int j = 0
        from j = 0 do
            skip
        loop
            local int c = 0
                call cmprot(s, n, j, i, c)
                r += c
                uncall cmprot(s, n, j, i, c)
            delocal int c = 0
            j += 1
        until j = n
    delocal int j = n

procedure lfrank(int L[], int n, int q, int r)
    local int t = 0
        from t = 0 do
            skip
        loop
            if L[t] < L[q] || (L[t] = L[q] && t < q) then
                r += 1
            else
                skip
            fi L[t] < L[q] || (L[t] = L[q] && t < q)
            t += 1
        until t = n
    delocal int t = n

procedure flrank(int L[], int n, int q, int t)
    local int u = 0
        from u = 0 do
            skip
        loop
            local int r = 0
                call lfrank(L, n, u, r)
                if r = q then
                    t += u
                else
                    skip
                fi r = q
                uncall lfrank(L, n, u, r)
            delocal int r = 0
            u += 1
        until u = n
    delocal int u = n

procedure clear_s(int s[], int n, int L[], int primary)
    local int q = primary
        local int k = n
            from k = n do
                skip
            loop
                k -= 1
                s[k] -= L[q]
                local int r = 0
                    call lfrank(L, n, q, r)
                    q <=> r
                    uncall flrank(L, n, q, r)
                delocal int r = 0
            until k = 0
        delocal int k = 0
    delocal int q = primary

procedure bwt_plain(int s[], int n, int L[], int primary)
    local int i = 0
        from i = 0 do
            skip
        loop
            local int r = 0
                call rankof(s, n, i, r)
                L[r] += s[(i + n - 1) % n]
                if i = 0 then
                    primary += r
                else
                    skip
                fi i = 0
                uncall rankof(s, n, i, r)
            delocal int r = 0
            i += 1
        until i = n
    delocal int i = n
    call clear_s(s, n, L, primary)

procedure main()
    int s[6]
    int n
    int L[6]
    int primary

    s[0] += 1
    s[1] += 2
    s[2] += 1
    s[3] += 2
    s[4] += 1
    s[5] += 2
    n += 6

    call bwt_plain(s, n, L, primary)
    // expected: s=[0, 0, 0, 0, 0, 0], n=6, L=[2, 2, 2, 1, 1, 1], primary=0
    printf("s = %d %d %d %d %d %d\n", s[0], s[1], s[2], s[3], s[4], s[5])
    printf("n = %d\n", n)
    printf("L = %d %d %d %d %d %d\n", L[0], L[1], L[2], L[3], L[4], L[5])
    printf("primary = %d\n", primary)
