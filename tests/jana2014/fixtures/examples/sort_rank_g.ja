// @summary:   selection sort recording how far ahead each pass found its minimum
// @technique: history-stack
// @source:    gen_janus hard13-15 experiments (2026-07)
// @confirmed: reproduced by tests/jana2014/reference/sort_rank_g.py, an independent Python implementation written from the algorithm (only the inputs are transcribed from main); it agrees on a, n, tr
// @keep:      a, n
// @expect: a = 1 1 2 2 3
// @expect: n = 5
// @expect: tr = 1 2 0 1 0
// @expect: a[5] = {1, 1, 2, 2, 3}
// @expect: n = 5
// @expect: tr[5] = {1, 2, 0, 1, 0}
//
// In-place sort with an invented compact permutation trace (stable insertion
// positions), fitting a bank of at most n-1 nonzero cells below n.
//
// Contributed from the gen_janus hard13-15 experiments (2026-07):
// solution generated by Claude Opus 4.8 and verified clean against the
// frozen oracle test cases (hidden cases included).

procedure count(int a[], int n, int i, int c1, int c2)
    local int k = i
    from k = i do
        if a[k] = 1 then c1 += 1 else skip fi a[k] = 1
        if a[k] = 2 then c2 += 1 else skip fi a[k] = 2
    loop
        k += 1
    until k = n - 1
    delocal int k = n - 1

procedure sort_rank(int a[], int n, int tr[])
    local int i = 0
    from i = 0 do
        local int c1 = 0
        local int c2 = 0
        call count(a, n, i, c1, c2)
        local int minv = 1 + (c1 = 0) + ((c1 = 0) && (c2 = 0))
        local int j = i
        from j = i do
            skip
        loop
            j += 1
        until a[j] = minv
        tr[i] += j - i
        if j > i then
            a[i] <=> a[j]
        else
            skip
        fi j > i
        delocal int j = i + tr[i]
        delocal int minv = 1 + (c1 = 0) + ((c1 = 0) && (c2 = 0))
        uncall count(a, n, i, c1, c2)
        delocal int c2 = 0
        delocal int c1 = 0
    loop
        i += 1
    until i = n - 1
    delocal int i = n - 1

procedure main()
    int a[5]
    int n
    int tr[5]

    a[0] += 3
    a[1] += 1
    a[2] += 2
    a[3] += 1
    a[4] += 2
    n += 5

    call sort_rank(a, n, tr)
    // expected: a=[1, 1, 2, 2, 3], n=5
    printf("a = %d %d %d %d %d\n", a[0], a[1], a[2], a[3], a[4])
    printf("n = %d\n", n)
    printf("tr = %d %d %d %d %d\n", tr[0], tr[1], tr[2], tr[3], tr[4])
