// @summary:    two array formals of the same procedure bound to the same array
// @error-kind: execution
// @error:      Identifiers `a' and `b' are aliases

procedure foo(int x[], int y[])
    call bar(x, y)

procedure bar(int a[], int b[])
    a[1] += b[1]

procedure main()
    int x[3]

    call foo(x, x)
