// @summary:    two scalar formals of the same procedure bound to the same variable
// @error-kind: execution
// @error:      Identifiers `a' and `b' are aliases

procedure foo(int x, int y)
    call bar(x, y)

procedure bar(int a, int b)
    a += b

procedure main()
    int x

    x += 5
    call foo(x, x)
